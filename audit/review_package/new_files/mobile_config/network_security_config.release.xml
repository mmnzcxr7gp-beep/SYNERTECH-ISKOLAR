<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration for release: Cleartext HTTP traffic is strictly blocked across all domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
