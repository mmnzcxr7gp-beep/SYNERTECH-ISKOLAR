# MongoDB Configuration
# Replace <db_password> with your actual MongoDB Atlas password
# Format: mongodb+srv://username:password@cluster.mongodb.net/?appName=dbname
MONGO_URI="mongodb+srv://samgarciavillaluna_db_user:<db_password>@iskolar-main.0lz3nds.mongodb.net/?appName=iskolar-main"

# JWT Secret Key (REQUIRED - Generate a strong random string)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Email Configuration (Required for OTP verification)
# For Gmail: Enable 2FA and generate App Password at https://myaccount.google.com/apppasswords
EMAIL_SERVICE="gmail"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="465"
EMAIL_SECURE="true"
EMAIL_USER="iskolar.official@gmail.com"
EMAIL_PASSWORD="<GMAIL_APP_PASSWORD>"
EMAIL_FROM="ISKOLAR Official <iskolar.official@gmail.com>"

# SMS OTP Configuration (Twilio Verify)
SMS_ENABLED="false"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Cloud Storage Configuration (Local Disk vs Cloudflare R2 / AWS S3)
STORAGE_DRIVER="local" # "local" or "r2" / "s3"
STORAGE_TYPE="local" # "local" or "r2" / "s3"
R2_ACCOUNT_ID="" # e.g. 8eb7d9b780431b7af22e28c7a6c79ee2
R2_BUCKET="" # e.g. iskolar-documents
R2_ENDPOINT="" # e.g. https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID="" # S3 client Access Key ID
R2_SECRET_ACCESS_KEY="" # S3 client Secret Access Key
R2_TOKEN="" # Optional Cloudflare API Token
R2_REGION="auto"
# S3 Aliases (Alternative)
S3_BUCKET_NAME=""
S3_REGION="auto"
S3_ENDPOINT="" # e.g. https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Firebase Configuration (Optional: for FCM Push Notifications)
# Pass raw or base64 encoded service account JSON string for Vercel deployment
FIREBASE_SERVICE_ACCOUNT_JSON=""

# CORS Origins (comma-separated list of allowed origins)
# Example: https://your-frontend.vercel.app,https://your-admin.vercel.app
CORS_ORIGINS="http://localhost:5173,http://localhost:4000"

# Security Test Overrides (Keep false / unset in production)
ALLOW_TEST_OVERRIDE="false"

# Node Environment
NODE_ENV="development"

# Optional: Port Configuration
PORT=4000

