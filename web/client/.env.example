# ISKOLAR Web Admin & Provider Portal Environment Configuration

# Express API Base URL (Local Development vs Production)
VITE_API_URL=http://localhost:4000

# Optional Dedicated Socket.IO Server URL (defaults to VITE_API_URL root)
VITE_SOCKET_URL=http://localhost:4000

# Sentry DSN for Web Error Monitoring (Optional)
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Environment Mode
VITE_ENV=development
