# ISKOLAR Mobile Student App Environment Configuration

# Centralized Express Backend API URL
# Android Emulator: http://10.0.2.2:4000
# iOS Simulator / Physical Device: http://localhost:4000 or http://<YOUR_LOCAL_IP>:4000
API_BASE_URL=http://10.0.2.2:4000

# Socket.IO Real-time Connection Server URL
SOCKET_URL=http://10.0.2.2:4000

# Environment Name
ENVIRONMENT=development

# Optional Sentry DSN for Mobile Crash Reporting
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
