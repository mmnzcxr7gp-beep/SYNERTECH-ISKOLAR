{
  "name": "iskolar-monorepo",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "server": "npm --prefix web/server start",
    "server:dev": "npm --prefix web/server run dev",
    "client": "npm --prefix web/client run dev",
    "client:build": "npm --prefix web/client run build",
    "postinstall": "npm --prefix web/client install",
    "build": "npm --prefix web/client install && npm --prefix web/client run build",
    "dev": "concurrently \"npm:server:dev\" \"npm:client\"",
    "test:server": "npm --prefix web/server test",
    "test:mobile": "cd mobile && flutter test"
  },
  "devDependencies": {
    "concurrently": "^8.0.1",
    "cross-env": "^10.1.0",
    "puppeteer": "^25.4.0"
  }
}
